# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=payparity
POSTGRES_PASSWORD=payparity_secret
POSTGRES_DB=payparity
DATABASE_URL=sqlite+aiosqlite:///./payparity.db
SYNC_DATABASE_URL=sqlite:///./payparity.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=memory://

# ── LLM (OpenAI) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
# Set to "mock" to run agents without an API key (uses deterministic mock responses)
AGENT_MODE=mock

# ── Differential Privacy ──────────────────────────────────────────────────────
DEFAULT_PRIVACY_EPSILON=1.0
DEFAULT_PRIVACY_DELTA=1e-5
MAX_PRIVACY_EPSILON=10.0

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_METRICS=true
